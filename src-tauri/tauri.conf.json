{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LobbyTracker",
  "version": "0.1.0",
  "identifier": "io.lobbytracker.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LobbyTracker",
        "url": "index.html",
        "width": 940,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560
      },
      {
        "label": "overlay",
        "title": "LobbyTracker Overlay",
        "url": "overlay.html",
        "width": 380,
        "height": 420,
        "x": 40,
        "y": 40,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
