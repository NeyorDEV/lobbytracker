{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Fenêtres locales : paramètres et overlay",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-size",
    "allow-get-config",
    "allow-save-config",
    "allow-get-snapshot",
    "allow-default-log-path",
    "allow-set-click-through",
    "allow-toggle-overlay",
    "allow-set-preview"
  ]
}
